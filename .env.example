# Copia este archivo como .env y pon tus valores. .env está gitignorado.
# El entorno real siempre gana: si la variable ya existe en tu shell, este
# archivo no la sobrescribe.

# Obligatorio para planear. Se saca de console.anthropic.com → API keys.
ANTHROPIC_API_KEY=sk-ant-...

# Solo para insumos jira:. Omite EMAIL y TOKEN para trackers públicos.
# JIRA_BASE_URL=https://issues.apache.org/jira
# JIRA_API_VERSION=2
# JIRA_EMAIL=
# JIRA_API_TOKEN=

# Ambiente de pruebas para ejecución auto-api.
# KRITERIA_API_BASE_URL=
# KRITERIA_API_TOKEN=
