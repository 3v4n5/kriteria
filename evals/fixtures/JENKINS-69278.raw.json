              "48x48": "https://issues.jenkins.io/secure/useravatar?ownerId=markewaite&avatarId=12478",
              "24x24": "https://issues.jenkins.io/secure/useravatar?size=small&ownerId=markewaite&avatarId=12478",
              "16x16": "https://issues.jenkins.io/secure/useravatar?size=xsmall&ownerId=markewaite&avatarId=12478",
